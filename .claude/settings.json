{
  "extraKnownMarketplaces": {
    "yuzuru-engineering": {
      "source": {
        "source": "github",
        "repo": "MattoYuzuru/yuzuru-skills"
      }
    }
  },
  "enabledPlugins": {
    "cleaner-agent@yuzuru-engineering": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-hooks/post-edit.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$CLAUDE_PROJECT_DIR\"/scripts/agent-hooks/check-state.py after",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-hooks/stop-check.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$CLAUDE_PROJECT_DIR\"/scripts/agent-hooks/check-state.py before",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$CLAUDE_PROJECT_DIR\"/scripts/agent-hooks/check-state.py after",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
