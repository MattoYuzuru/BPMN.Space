# Единственный шаблон конфигурации. Скопируй в .env и заполни. Секреты в git не коммитим.

# --- Backend ---
APP_ENV=dev
WEB_PORT=8080
AUTH_ENABLED=true
# Обучение и чек-лист «Начало работы» (нужен AUTH_ENABLED=true). false — продукт без онбординга.
ONBOARDING_ENABLED=true
# Разрешённые источники браузера (JSON-список); по умолчанию — локальные фронтенды.
# CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Secure у cookie сессии и CSRF. Пустое значение (или строка закомментирована) — решает APP_ENV:
# production => Secure, и вход работает только по HTTPS. На стенде без HTTPS задайте false.
# SESSION_COOKIE_SECURE=
# Анти-спам лимиты, запросов в минуту (скользящее окно, один процесс). Значения щедрые.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_API_PER_MIN=600
# RATE_LIMIT_AUTH_PER_MIN=20
# RATE_LIMIT_EXPENSIVE_PER_MIN=60
# RATE_LIMIT_EXPENSIVE_IP_PER_MIN=120

# --- MCP-сервер внешних агентов (/mcp, RFC-0007) ---
# Секрет подписи оценки прогона (estimate_token). Пусто — случайный на процесс: оценки
# становятся недействительными после перезапуска, это безопасно. Для стенда задайте
# openssl rand -hex 32.
# MCP_ESTIMATE_SECRET=
# Срок жизни оценки прогона, секунды: start_run без свежей оценки отклоняется.
# MCP_ESTIMATE_TTL_SEC=900
# Дорогие вызовы MCP (start_run) на токен в минуту.
# MCP_EXPENSIVE_PER_MIN=30

# Для локального Docker Compose эти значения используются PostgreSQL.
# Вне Docker DATABASE_URL можно не задавать: API останется в in-memory режиме.
POSTGRES_DB=arkhitektor
POSTGRES_USER=arkhitektor
# Только для локальной разработки. Для VM задайте отдельный секрет ≥32 символов,
# например: openssl rand -hex 32. upload-server-env.sh читает его отсюда в production .env.
POSTGRES_PASSWORD=local-dev-only
# Отдельный production-секрет для VM; локальный Compose его не использует.
DEPLOY_POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://arkhitektor:local-dev-only@localhost:5433/arkhitektor
# Bounded SQLAlchemy pool per backend worker. Raise only with the PostgreSQL connection budget in mind.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SEC=5
UPLOAD_DIR=./data/uploads

# Не больше стольких прогонов одновременно; общий срок одного прогона (0 — без срока).
MAX_CONCURRENT_RUNS=2
# RUN_DEADLINE_SEC — нижняя граница; к ней добавляется RUN_DEADLINE_PER_1K_CHARS_SEC секунд на каждую
# 1000 символов активных источников, но не больше RUN_DEADLINE_MAX_SEC (0 — без потолка).
RUN_DEADLINE_SEC=600
RUN_DEADLINE_PER_1K_CHARS_SEC=4
RUN_DEADLINE_MAX_SEC=7200
# Бюджет источников прогона считается из окна выбранной модели (RFC-0005): у Claude 5.5 —
# ≈ 1,7 млн знаков. Это значение — нижняя граница и бюджет моделей с неизвестным окном
# (совместимые провайдеры, mock). Что не помещается, идёт порциями извлечения цитат.
LLM_CONTEXT_BUDGET_CHARS=120000
# Потолок рассчитанного бюджета, знаки (0 — без потолка). Задайте, если лимит входных токенов
# в минуту у аккаунта провайдера не пропускает запрос на всё окно модели.
LLM_CONTEXT_BUDGET_MAX_CHARS=0
# Размер порции текста при извлечении оснований и сверке; запросы порций идут параллельно.
LLM_CHUNK_CHARS=24000
LLM_PARALLEL_REQUESTS=4

# Агентный режим (RFC-0004): модель сама читает источники инструментами и сдаёт IR.
# Выключен по умолчанию; включайте после оценки на эталонах (prompt-eval). Режим доступен
# только моделям с инструментами (Claude 5.5, OpenAI tools); профиль прогона mode=agent.
LLM_AGENT_MODE=false
# Потолок ходов агента на прогон и объём одного read_source; поиск — лимит и размер фрагмента.
LLM_AGENT_MAX_STEPS=24
LLM_AGENT_READ_MAX_CHARS=12000
LLM_AGENT_SEARCH_LIMIT=5
LLM_AGENT_SEARCH_SNIPPET_CHARS=400
# Документы (.docx .xlsx .pptx .pdf …); записи (аудио/видео) — отдельный лимит.
MAX_UPLOAD_BYTES=52428800
MAX_MEDIA_BYTES=524288000
# Голосовая заметка из микрофона (синхронная расшифровка).
MAX_AUDIO_BYTES=62914560
MAX_DIAGRAM_BYTES=5242880
# Сессия правок: автосохранения одного автора сливаются в одну версию, пока пауза меньше IDLE
# и сессия короче MAX (секунды). IDLE=0 — каждое сохранение создаёт версию.
VERSION_SESSION_IDLE_SEC=600
VERSION_SESSION_MAX_SEC=3600
# Текст одного источника после разбора (≈ 500 страниц).
MAX_TEXT_CHARS=1500000
# Разбор документов: страницы PDF, строки листа Excel, время на файл (отдельный поток).
MAX_PDF_PAGES=1000
MAX_SHEET_ROWS=20000
PARSE_TIMEOUT_SEC=180
# Аудио и видео: ffmpeg режет звук на сегменты, расшифровка сегментов идёт параллельно.
MEDIA_SEGMENT_SEC=600
STT_PARALLEL_SEGMENTS=3
MOCK_DELAY_SCALE=1.0
MOCK_TRANSCRIPTION_DELAY_SEC=1.0
MOCK_PARSE_DELAY_SEC=1.5
SEED_DEMO_DATA=true

# --- LLM: любой провайдер с OpenAI-compatible Chat Completions API ---
# Секреты держать только в корневом .env; опубликованные в переписке ключи перевыпустить.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SEC=120
LLM_JSON_MODE=true
# Лимит выходных токенов анализа/IR. Не задан — максимум модели из справочника (Claude 5.5 —
# 128 тыс., потоком), у моделей с неизвестным максимумом — 16384. Заданный явно — потолок для всех.
# Чат помощника сохраняет отдельный лимит 4096.
# LLM_JSON_MAX_TOKENS=16384
# Лимит ответа порций (извлечение оснований, сверка, анализ пакетами): провайдер резервирует
# лимит выходных токенов в минуту по max_tokens, а порции идут параллельно.
LLM_CHUNK_MAX_TOKENS=16384
# Температура JSON-ответов (анализ и сборка). 0 — минимум ответов не по схеме.
LLM_JSON_TEMPERATURE=0
# Повторы временных сбоев (HTTP 408/429/5xx, таймаут): пауза растёт от BASE до MAX секунд с джиттером.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SEC=1
LLM_RETRY_MAX_SEC=30
# Только для LLM_PROVIDER=deepseek: рассуждение съедает лимит ответа и обрезает JSON, держим выключенным.
# DEEPSEEK_THINKING_ENABLED=false
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=ключ_провайдера

# Провайдеры: openai_compatible (DeepSeek, OpenRouter, vLLM), openai, anthropic, mock.
# Это модель оператора — запасной вариант для тех, кто не добавил свой ключ в «Настройках».
# Anthropic: LLM_PROVIDER=anthropic, LLM_MODEL=claude-opus-5-5, LLM_API_KEY (LLM_BASE_URL не нужен).
# Глубина рассуждения Anthropic без профиля прогона: low | medium | high | xhigh | max.
# Не задана — умолчание модели (Opus 5.5 — medium, Sonnet 5.5 — high). Профиль прогона главнее.
# LLM_ANTHROPIC_EFFORT=medium
# Предельный уровень, который любой пользователь может попросить у модели сервера (ключ
# оператора): low | medium | high | xhigh | max. Не задан — уровень сервера по умолчанию.
# LLM_SERVER_MAX_EFFORT=high

# --- Ключи пользователей по типам задач (RFC-0006, обобщает ADR-0011) ---
# Ключи Fernet через запятую: первый шифрует, остальные только расшифровывают (ротация).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# В production без него ключи пользователей не принимаются; в dev берётся временный ключ процесса.
# CREDENTIALS_ENCRYPTION_KEY=
# Хосты закрытых сетей, куда разрешено ходить совместимым провайдерам (локальный vLLM в dev).
# По умолчанию пусто: только публичные адреса по HTTPS.
# LLM_ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1
LLM_MODELS_CACHE_SEC=300
# Потолок тела ответа сервера модели в байтах (чат и список моделей)
LLM_MAX_RESPONSE_BYTES=8388608
# Маршрутизация инструментов: повторы временного сбоя ключа и предохранитель.
# CAPABILITY_MAX_ATTEMPTS=2
# CAPABILITY_RETRY_BASE_SEC=1
# CAPABILITY_RETRY_MAX_SEC=30
# CAPABILITY_BREAKER_THRESHOLD=3
# CAPABILITY_BREAKER_COOLDOWN_SEC=60
# Пауза ключа при исчерпанной квоте, если провайдер не прислал Retry-After.
# CAPABILITY_QUOTA_COOLDOWN_SEC=3600

# --- Распознавание речи ---
# Пользователь может добавить свой ключ Deepgram/OpenAI/Groq в «Настройках»; серверный STT —
# запасной путь для тех, у кого ключа нет, и текущее поведение production.
# mock подставляет примерный текст по содержимому файла; для реального распознавания настройте Deepgram.
# В production STT_PROVIDER=mock запрещён: backend не стартует.
STT_PROVIDER=mock
# DEEPGRAM_API_KEY=новый_ключ_после_перевыпуска
# DEEPGRAM_TIMEOUT_SEC=120

# --- Инструменты разработки ---
# GITLAB_TOKEN=            # PAT (scope api) для scripts/mr-report.sh

# Runtime Node layout и полный bpmnlint. В Compose адрес уже задан; локально: make dev-bpmn-tools.
BPMN_TOOLS_URL=
BPMN_TOOLS_TIMEOUT_SEC=20
# Тёплый пул worker-ов sidecar: размер, очередь ожидания (переполнение — 503) и перезапуск после N задач.
# BPMN_TOOLS_POOL_SIZE=2
# BPMN_TOOLS_QUEUE_LIMIT=32
# BPMN_TOOLS_WORKER_MAX_JOBS=200

# --- Ресурсы контейнеров (Compose; значения по умолчанию рассчитаны на VPS с 4 ГБ) ---
# BACKEND_MEM_LIMIT=1536m
# BACKEND_CPUS=1.5
# BPMN_TOOLS_MEM_LIMIT=768m
# BPMN_TOOLS_CPUS=1.0
# DB_MEM_LIMIT=1g
# DB_CPUS=1.0
# WEB_MEM_LIMIT=256m
# WEB_CPUS=0.5
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAINTENANCE_WORK_MEM=64MB
# POSTGRES_MAX_CONNECTIONS=40

# Независимая смысловая проверка графа (дополнительный вызов модели перед публикацией).
LLM_SEMANTIC_REVIEW=true
