      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_InPlan" bpmnElement="Gateway_InPlan" isMarkerVisible="true">
        <dc:Bounds x="686" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="669" y="382" width="85" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_AmendPlan" bpmnElement="Task_AmendPlan">
        <dc:Bounds x="836" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_PlanMerge" bpmnElement="Gateway_PlanMerge" isMarkerVisible="true">
        <dc:Bounds x="1036" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_Publish" bpmnElement="Task_Publish">
        <dc:Bounds x="1186" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_CollectBids" bpmnElement="Task_CollectBids">
        <dc:Bounds x="1386" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_Evaluate" bpmnElement="Task_Evaluate">
        <dc:Bounds x="1586" y="800" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_HasBids" bpmnElement="Gateway_HasBids" isMarkerVisible="true">
        <dc:Bounds x="1786" y="815" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1774" y="768" width="74" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_Failed" bpmnElement="Task_Failed">
        <dc:Bounds x="1936" y="800" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_EndEvent_Failed" bpmnElement="EndEvent_Failed">
        <dc:Bounds x="2168" y="822" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2149" y="863" width="74" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_Protocol" bpmnElement="Task_Protocol">
        <dc:Bounds x="1936" y="960" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_Contract" bpmnElement="Task_Contract">
        <dc:Bounds x="2136" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_EndEvent_Contract" bpmnElement="EndEvent_Contract">
        <dc:Bounds x="2336" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2324" y="623" width="60" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Need_Request" bpmnElement="Flow_Need_Request">
        <di:waypoint x="186" y="200" />
        <di:waypoint x="286" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Request_CheckPlan" bpmnElement="Flow_Request_CheckPlan">
        <di:waypoint x="386" y="200" />
        <di:waypoint x="536" y="200" />
        <di:waypoint x="536" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_CheckPlan_InPlan" bpmnElement="Flow_CheckPlan_InPlan">
        <di:waypoint x="586" y="440" />
        <di:waypoint x="686" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_InPlan_AmendPlan" bpmnElement="Flow_InPlan_AmendPlan">
        <di:waypoint x="736" y="440" />
        <di:waypoint x="836" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="774" y="418" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_AmendPlan_PlanMerge" bpmnElement="Flow_AmendPlan_PlanMerge">
        <di:waypoint x="936" y="440" />
        <di:waypoint x="1036" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_PlanMerge_Publish" bpmnElement="Flow_PlanMerge_Publish">
        <di:waypoint x="1086" y="440" />
        <di:waypoint x="1186" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Publish_CollectBids" bpmnElement="Flow_Publish_CollectBids">
        <di:waypoint x="1286" y="440" />
        <di:waypoint x="1386" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_CollectBids_Evaluate" bpmnElement="Flow_CollectBids_Evaluate">
        <di:waypoint x="1486" y="440" />
        <di:waypoint x="1636" y="440" />
        <di:waypoint x="1636" y="800" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Evaluate_HasBids" bpmnElement="Flow_Evaluate_HasBids">
        <di:waypoint x="1686" y="840" />
        <di:waypoint x="1786" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_HasBids_Failed" bpmnElement="Flow_HasBids_Failed">
        <di:waypoint x="1836" y="840" />
        <di:waypoint x="1936" y="840" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1874" y="818" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Failed_Failed" bpmnElement="Flow_Failed_Failed">
        <di:waypoint x="2036" y="840" />
        <di:waypoint x="2168" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_HasBids_Protocol" bpmnElement="Flow_HasBids_Protocol">
        <di:waypoint x="1811" y="865" />
        <di:waypoint x="1811" y="1000" />
        <di:waypoint x="1936" y="1000" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1817" y="926" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_InPlan_PlanMerge" bpmnElement="Flow_InPlan_PlanMerge">
        <di:waypoint x="711" y="465" />
        <di:waypoint x="711" y="500" />
        <di:waypoint x="1061" y="500" />
        <di:waypoint x="1061" y="465" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="877" y="508" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Protocol_Contract" bpmnElement="Flow_Protocol_Contract">
        <di:waypoint x="2036" y="1000" />
        <di:waypoint x="2116" y="1000" />
        <di:waypoint x="2116" y="600" />
        <di:waypoint x="2136" y="600" />
