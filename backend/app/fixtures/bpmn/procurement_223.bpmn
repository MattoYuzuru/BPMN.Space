        <di:waypoint x="2236" y="600" />
        <di:waypoint x="2336" y="600" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
