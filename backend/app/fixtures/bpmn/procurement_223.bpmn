<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_procurement_223" targetNamespace="http://arkhitektor.local/bpmn" exporter="Архитектор BPMN-диаграмм" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_procurement_223">
    <bpmn:participant id="Participant_procurement_223" name="Закупка способом запроса котировок" processRef="Process_procurement_223" />
  </bpmn:collaboration>
  <bpmn:process id="Process_procurement_223" isExecutable="false">
    <bpmn:laneSet id="LaneSet_procurement_223">
      <bpmn:lane id="Lane_Initiator" name="Инициатор закупки">
        <bpmn:flowNodeRef>StartEvent_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Отдел закупок">
        <bpmn:flowNodeRef>Task_CheckPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AmendPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlanMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectBids</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Contract</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Commission" name="Закупочная комиссия">
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasBids</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Protocol</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Need" name="Возникла потребность">
      <bpmn:outgoing>Flow_Need_Request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Request" name="Сформировать заявку и техническое задание">
      <bpmn:incoming>Flow_Need_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_CheckPlan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CheckPlan" name="Проверить наличие в плане закупок">
      <bpmn:incoming>Flow_Request_CheckPlan</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckPlan_InPlan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_InPlan" name="Закупка есть в плане?">
      <bpmn:incoming>Flow_CheckPlan_InPlan</bpmn:incoming>
      <bpmn:outgoing>Flow_InPlan_AmendPlan</bpmn:outgoing>
      <bpmn:outgoing>Flow_InPlan_PlanMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AmendPlan" name="Внести изменения в план закупок">
      <bpmn:incoming>Flow_InPlan_AmendPlan</bpmn:incoming>
      <bpmn:outgoing>Flow_AmendPlan_PlanMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PlanMerge">
      <bpmn:incoming>Flow_InPlan_PlanMerge</bpmn:incoming>
      <bpmn:incoming>Flow_AmendPlan_PlanMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_PlanMerge_Publish</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Publish" name="Разместить извещение в ЕИС">
      <bpmn:incoming>Flow_PlanMerge_Publish</bpmn:incoming>
      <bpmn:outgoing>Flow_Publish_CollectBids</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_CollectBids" name="Принять заявки участников">
      <bpmn:incoming>Flow_Publish_CollectBids</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectBids_Evaluate</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_Evaluate" name="Рассмотреть и оценить заявки">
      <bpmn:incoming>Flow_CollectBids_Evaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_Evaluate_HasBids</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HasBids" name="Есть допущенные заявки?">
      <bpmn:incoming>Flow_Evaluate_HasBids</bpmn:incoming>
      <bpmn:outgoing>Flow_HasBids_Failed</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasBids_Protocol</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Failed" name="Закрыть закупку без договора">
      <bpmn:incoming>Flow_HasBids_Failed</bpmn:incoming>
      <bpmn:outgoing>Flow_Failed_Failed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Failed" name="Закупка не состоялась">
      <bpmn:incoming>Flow_Failed_Failed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Protocol" name="Подписать итоговый протокол">
      <bpmn:incoming>Flow_HasBids_Protocol</bpmn:incoming>
      <bpmn:outgoing>Flow_Protocol_Contract</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Contract" name="Заключить договор с победителем">
      <bpmn:incoming>Flow_Protocol_Contract</bpmn:incoming>
      <bpmn:outgoing>Flow_Contract_Contract</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Contract" name="Договор заключён">
      <bpmn:incoming>Flow_Contract_Contract</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Need_Request" sourceRef="StartEvent_Need" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="Flow_Request_CheckPlan" sourceRef="Task_Request" targetRef="Task_CheckPlan" />
    <bpmn:sequenceFlow id="Flow_CheckPlan_InPlan" sourceRef="Task_CheckPlan" targetRef="Gateway_InPlan" />
    <bpmn:sequenceFlow id="Flow_InPlan_AmendPlan" name="Нет" sourceRef="Gateway_InPlan" targetRef="Task_AmendPlan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">закупки нет в плане</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InPlan_PlanMerge" name="Да" sourceRef="Gateway_InPlan" targetRef="Gateway_PlanMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">закупка есть в плане</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AmendPlan_PlanMerge" sourceRef="Task_AmendPlan" targetRef="Gateway_PlanMerge" />
    <bpmn:sequenceFlow id="Flow_PlanMerge_Publish" sourceRef="Gateway_PlanMerge" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="Flow_Publish_CollectBids" sourceRef="Task_Publish" targetRef="Task_CollectBids" />
    <bpmn:sequenceFlow id="Flow_CollectBids_Evaluate" sourceRef="Task_CollectBids" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_Evaluate_HasBids" sourceRef="Task_Evaluate" targetRef="Gateway_HasBids" />
    <bpmn:sequenceFlow id="Flow_HasBids_Failed" name="Нет" sourceRef="Gateway_HasBids" targetRef="Task_Failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">допущенных заявок нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Failed_Failed" sourceRef="Task_Failed" targetRef="EndEvent_Failed" />
    <bpmn:sequenceFlow id="Flow_HasBids_Protocol" name="Да" sourceRef="Gateway_HasBids" targetRef="Task_Protocol">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">есть допущенные заявки</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Protocol_Contract" sourceRef="Task_Protocol" targetRef="Task_Contract" />
    <bpmn:sequenceFlow id="Flow_Contract_Contract" sourceRef="Task_Contract" targetRef="EndEvent_Contract" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_procurement_223">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_procurement_223" bpmnElement="Collaboration_procurement_223">
