<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_repair_outage" targetNamespace="http://arkhitektor.local/bpmn" exporter="Архитектор BPMN-диаграмм" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_repair_outage">
    <bpmn:participant id="Participant_repair_outage" name="Вывод оборудования в ремонт" processRef="Process_repair_outage" />
  </bpmn:collaboration>
  <bpmn:process id="Process_repair_outage" isExecutable="false">
    <bpmn:laneSet id="LaneSet_repair_outage">
      <bpmn:lane id="Lane_Owner" name="Собственник оборудования">
        <bpmn:flowNodeRef>StartEvent_Planned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtendRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportReady</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dispatch" name="Диспетчерский центр">
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRefusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommandOutage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveExtension</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommandReturn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operators" name="Оперативный персонал">
        <bpmn:flowNodeRef>Task_Switching</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareWorkplace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnToService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InService</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Brigade" name="Ремонтная бригада">
        <bpmn:flowNodeRef>Gateway_WorksMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairWorks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InTime</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Planned" name="Ремонт включён в график">
      <bpmn:outgoing>Flow_Planned_PrepareRequest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PrepareRequest" name="Подготовить диспетчерскую заявку">
      <bpmn:incoming>Flow_Planned_PrepareRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareRequest_SubmitRequest</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SubmitRequest" name="Подать заявку в диспетчерский центр">
      <bpmn:incoming>Flow_PrepareRequest_SubmitRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitRequest_ReviewRequest</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_ReviewRequest" name="Рассмотреть заявку с учётом режимов">
      <bpmn:incoming>Flow_SubmitRequest_ReviewRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewRequest_Approved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Вывод в ремонт допустим?">
      <bpmn:incoming>Flow_ReviewRequest_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_NotifyRefusal</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approved_CommandOutage</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyRefusal" name="Сообщить об отказе и причинах">
      <bpmn:incoming>Flow_Approved_NotifyRefusal</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyRefusal_Refused</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Refused" name="Заявка отклонена">
      <bpmn:incoming>Flow_NotifyRefusal_Refused</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_CommandOutage" name="Дать команду на вывод в ремонт">
      <bpmn:incoming>Flow_Approved_CommandOutage</bpmn:incoming>
      <bpmn:outgoing>Flow_CommandOutage_Switching</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_Switching" name="Выполнить переключения по бланку">
      <bpmn:incoming>Flow_CommandOutage_Switching</bpmn:incoming>
      <bpmn:outgoing>Flow_Switching_PrepareWorkplace</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_PrepareWorkplace" name="Подготовить рабочее место и допустить бригаду">
      <bpmn:incoming>Flow_Switching_PrepareWorkplace</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareWorkplace_WorksMerge</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_WorksMerge">
      <bpmn:incoming>Flow_PrepareWorkplace_WorksMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ApproveExtension_WorksMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_WorksMerge_RepairWorks</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_RepairWorks" name="Выполнить ремонтные работы">
      <bpmn:incoming>Flow_WorksMerge_RepairWorks</bpmn:incoming>
      <bpmn:outgoing>Flow_RepairWorks_InTime</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_InTime" name="Работы укладываются в срок?">
      <bpmn:incoming>Flow_RepairWorks_InTime</bpmn:incoming>
      <bpmn:outgoing>Flow_InTime_ExtendRequest</bpmn:outgoing>
      <bpmn:outgoing>Flow_InTime_ReportReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_ExtendRequest" name="Запросить продление заявки">
      <bpmn:incoming>Flow_InTime_ExtendRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtendRequest_ApproveExtension</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_ApproveExtension" name="Согласовать продление">
      <bpmn:incoming>Flow_ExtendRequest_ApproveExtension</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveExtension_WorksMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_ReportReady" name="Сообщить о готовности к вводу">
      <bpmn:incoming>Flow_InTime_ReportReady</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportReady_CommandReturn</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_CommandReturn" name="Дать команду на ввод в работу">
      <bpmn:incoming>Flow_ReportReady_CommandReturn</bpmn:incoming>
      <bpmn:outgoing>Flow_CommandReturn_ReturnToService</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_ReturnToService" name="Ввести оборудование в работу">
      <bpmn:incoming>Flow_CommandReturn_ReturnToService</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnToService_InService</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="EndEvent_InService" name="Оборудование в работе">
      <bpmn:incoming>Flow_ReturnToService_InService</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Planned_PrepareRequest" sourceRef="StartEvent_Planned" targetRef="Task_PrepareRequest" />
    <bpmn:sequenceFlow id="Flow_PrepareRequest_SubmitRequest" sourceRef="Task_PrepareRequest" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_SubmitRequest_ReviewRequest" sourceRef="Task_SubmitRequest" targetRef="Task_ReviewRequest" />
    <bpmn:sequenceFlow id="Flow_ReviewRequest_Approved" sourceRef="Task_ReviewRequest" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Approved_NotifyRefusal" name="Нет" sourceRef="Gateway_Approved" targetRef="Task_NotifyRefusal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">вывод недопустим по режиму</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotifyRefusal_Refused" sourceRef="Task_NotifyRefusal" targetRef="EndEvent_Refused" />
    <bpmn:sequenceFlow id="Flow_Approved_CommandOutage" name="Да" sourceRef="Gateway_Approved" targetRef="Task_CommandOutage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">заявка разрешена</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CommandOutage_Switching" sourceRef="Task_CommandOutage" targetRef="Task_Switching" />
    <bpmn:sequenceFlow id="Flow_Switching_PrepareWorkplace" sourceRef="Task_Switching" targetRef="Task_PrepareWorkplace" />
    <bpmn:sequenceFlow id="Flow_PrepareWorkplace_WorksMerge" sourceRef="Task_PrepareWorkplace" targetRef="Gateway_WorksMerge" />
    <bpmn:sequenceFlow id="Flow_WorksMerge_RepairWorks" sourceRef="Gateway_WorksMerge" targetRef="Task_RepairWorks" />
    <bpmn:sequenceFlow id="Flow_RepairWorks_InTime" sourceRef="Task_RepairWorks" targetRef="Gateway_InTime" />
    <bpmn:sequenceFlow id="Flow_InTime_ExtendRequest" name="Нет" sourceRef="Gateway_InTime" targetRef="Task_ExtendRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">срок не выдерживается</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ExtendRequest_ApproveExtension" sourceRef="Task_ExtendRequest" targetRef="Task_ApproveExtension" />
    <bpmn:sequenceFlow id="Flow_ApproveExtension_WorksMerge" sourceRef="Task_ApproveExtension" targetRef="Gateway_WorksMerge" />
    <bpmn:sequenceFlow id="Flow_InTime_ReportReady" name="Да" sourceRef="Gateway_InTime" targetRef="Task_ReportReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">работы завершены в срок</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReportReady_CommandReturn" sourceRef="Task_ReportReady" targetRef="Task_CommandReturn" />
    <bpmn:sequenceFlow id="Flow_CommandReturn_ReturnToService" sourceRef="Task_CommandReturn" targetRef="Task_ReturnToService" />
    <bpmn:sequenceFlow id="Flow_ReturnToService_InService" sourceRef="Task_ReturnToService" targetRef="EndEvent_InService" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_repair_outage">
