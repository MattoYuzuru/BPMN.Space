      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_RepairWorks_InTime" bpmnElement="Flow_RepairWorks_InTime">
        <di:waypoint x="3017.6000000000004" y="1560" />
        <di:waypoint x="3192.6000000000004" y="1560" />
