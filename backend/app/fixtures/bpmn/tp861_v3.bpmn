<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_tp861_v3" targetNamespace="http://arkhitektor.local/bpmn" exporter="Архитектор BPMN-диаграмм" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_tp861_v3">
    <bpmn:participant id="Participant_tp861_v3" name="Технологическое присоединение к электросетям" processRef="Process_tp861_v3"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_tp861_v3" isExecutable="false">
    <bpmn:laneSet id="LaneSet_tp861_v3">
      <bpmn:lane id="Lane_Applicant" name="Заявитель">
        <bpmn:flowNodeRef>StartEvent_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayAndSign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WorksFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplicantWorks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Grid" name="Сетевая организация">
        <bpmn:flowNodeRef>Gateway_CheckMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Power</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferSmall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferLarge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PowerMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GridWorks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WorksJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignAct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeterAdmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToSupplier</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Финансовый отдел">
        <bpmn:flowNodeRef>Task_IssueInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supplier" name="Гарантирующий поставщик">
        <bpmn:flowNodeRef>Task_SupplyContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Connected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Need" name="Требуется присоединение">
      <bpmn:outgoing>Flow_Need_SubmitApplication</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_SubmitApplication" name="Подать заявку через личный кабинет">
      <bpmn:incoming>Flow_Need_SubmitApplication</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitApplication_CheckMerge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_CheckMerge">
      <bpmn:incoming>Flow_SubmitApplication_CheckMerge</bpmn:incoming>
      <bpmn:incoming>Flow_AddDocuments_CheckMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckMerge_CheckCompleteness</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CheckCompleteness" name="Проверить комплектность заявки">
      <bpmn:incoming>Flow_CheckMerge_CheckCompleteness</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckCompleteness_Complete</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Complete" name="Комплект полный?">
      <bpmn:incoming>Flow_CheckCompleteness_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_NotifyMissing</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complete_Power</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyMissing" name="Уведомить о недостающих сведениях">
      <bpmn:incoming>Flow_Complete_NotifyMissing</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyMissing_AddDocuments</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_AddDocuments" name="Дополнить заявку">
      <bpmn:incoming>Flow_NotifyMissing_AddDocuments</bpmn:incoming>
      <bpmn:outgoing>Flow_AddDocuments_CheckMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Power" name="Мощность до 150 кВт?">
      <bpmn:incoming>Flow_Complete_Power</bpmn:incoming>
      <bpmn:outgoing>Flow_Power_OfferSmall</bpmn:outgoing>
      <bpmn:outgoing>Flow_Power_OfferLarge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_OfferSmall" name="Разместить договор и ТУ (10 рабочих дней)">
      <bpmn:incoming>Flow_Power_OfferSmall</bpmn:incoming>
      <bpmn:outgoing>Flow_OfferSmall_PowerMerge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_OfferLarge" name="Направить договор и ТУ (20 рабочих дней)">
      <bpmn:incoming>Flow_Power_OfferLarge</bpmn:incoming>
      <bpmn:outgoing>Flow_OfferLarge_PowerMerge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_PowerMerge">
      <bpmn:incoming>Flow_OfferSmall_PowerMerge</bpmn:incoming>
      <bpmn:incoming>Flow_OfferLarge_PowerMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_PowerMerge_PayAndSign</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PayAndSign" name="Принять условия договора">
      <bpmn:incoming>Flow_PowerMerge_PayAndSign</bpmn:incoming>
      <bpmn:outgoing>Flow_PayAndSign_IssueInvoice</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_WorksFork">
      <bpmn:incoming>Flow_PayInvoice_WorksFork</bpmn:incoming>
      <bpmn:outgoing>Flow_WorksFork_ApplicantWorks</bpmn:outgoing>
      <bpmn:outgoing>Flow_WorksFork_GridWorks</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="Task_ApplicantWorks" name="Выполнить мероприятия по ТУ на своём участке">
      <bpmn:incoming>Flow_WorksFork_ApplicantWorks</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplicantWorks_WorksJoin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_GridWorks" name="Выполнить мероприятия по ТУ до границы участка">
      <bpmn:incoming>Flow_WorksFork_GridWorks</bpmn:incoming>
      <bpmn:outgoing>Flow_GridWorks_WorksJoin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="Gateway_WorksJoin">
      <bpmn:incoming>Flow_ApplicantWorks_WorksJoin</bpmn:incoming>
      <bpmn:incoming>Flow_GridWorks_WorksJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_WorksJoin_Inspection</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_Inspection" name="Провести выездной осмотр">
      <bpmn:incoming>Flow_WorksJoin_Inspection</bpmn:incoming>
      <bpmn:outgoing>Flow_Inspection_MeterAdmission</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SignAct" name="Присоединить и составить акт о ТП">
      <bpmn:incoming>Flow_MeterAdmission_SignAct</bpmn:incoming>
      <bpmn:outgoing>Flow_SignAct_SendToSupplier</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SupplyContract" name="Заключить договор с заявителем">
      <bpmn:incoming>Flow_SendToSupplier_SupplyContract</bpmn:incoming>
      <bpmn:outgoing>Flow_SupplyContract_Connected</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Connected" name="Присоединение выполнено">
      <bpmn:incoming>Flow_SupplyContract_Connected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_IssueInvoice" name="Сформировать счёт на оплату">
      <bpmn:incoming>Flow_PayAndSign_IssueInvoice</bpmn:incoming>
      <bpmn:outgoing>Flow_IssueInvoice_PayInvoice</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PayInvoice" name="Оплатить счёт">
      <bpmn:incoming>Flow_IssueInvoice_PayInvoice</bpmn:incoming>
      <bpmn:outgoing>Flow_PayInvoice_WorksFork</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MeterAdmission" name="Допустить прибор учёта в эксплуатацию">
      <bpmn:incoming>Flow_Inspection_MeterAdmission</bpmn:incoming>
      <bpmn:outgoing>Flow_MeterAdmission_SignAct</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendToSupplier" name="Направить акт поставщику">
      <bpmn:incoming>Flow_SignAct_SendToSupplier</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToSupplier_SupplyContract</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_Need_SubmitApplication" sourceRef="StartEvent_Need" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_CheckCompleteness_Complete" sourceRef="Task_CheckCompleteness" targetRef="Gateway_Complete"/>
    <bpmn:sequenceFlow id="Flow_Complete_NotifyMissing" name="Нет" sourceRef="Gateway_Complete" targetRef="Task_NotifyMissing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">комплект неполный</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotifyMissing_AddDocuments" sourceRef="Task_NotifyMissing" targetRef="Task_AddDocuments"/>
    <bpmn:sequenceFlow id="Flow_Complete_Power" name="Да" sourceRef="Gateway_Complete" targetRef="Gateway_Power">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">комплект полный</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Power_OfferSmall" name="Да" sourceRef="Gateway_Power" targetRef="Task_OfferSmall">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">мощность до 150 кВт</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Power_OfferLarge" name="Нет" sourceRef="Gateway_Power" targetRef="Task_OfferLarge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">мощность больше 150 кВт</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OfferSmall_PowerMerge" sourceRef="Task_OfferSmall" targetRef="Gateway_PowerMerge"/>
    <bpmn:sequenceFlow id="Flow_OfferLarge_PowerMerge" sourceRef="Task_OfferLarge" targetRef="Gateway_PowerMerge"/>
    <bpmn:sequenceFlow id="Flow_PowerMerge_PayAndSign" sourceRef="Gateway_PowerMerge" targetRef="Task_PayAndSign"/>
    <bpmn:sequenceFlow id="Flow_WorksFork_ApplicantWorks" sourceRef="Gateway_WorksFork" targetRef="Task_ApplicantWorks"/>
    <bpmn:sequenceFlow id="Flow_WorksFork_GridWorks" sourceRef="Gateway_WorksFork" targetRef="Task_GridWorks"/>
    <bpmn:sequenceFlow id="Flow_ApplicantWorks_WorksJoin" sourceRef="Task_ApplicantWorks" targetRef="Gateway_WorksJoin"/>
    <bpmn:sequenceFlow id="Flow_GridWorks_WorksJoin" sourceRef="Task_GridWorks" targetRef="Gateway_WorksJoin"/>
    <bpmn:sequenceFlow id="Flow_WorksJoin_Inspection" sourceRef="Gateway_WorksJoin" targetRef="Task_Inspection"/>
    <bpmn:sequenceFlow id="Flow_SupplyContract_Connected" sourceRef="Task_SupplyContract" targetRef="EndEvent_Connected"/>
    <bpmn:sequenceFlow id="Flow_SubmitApplication_CheckMerge" sourceRef="Task_SubmitApplication" targetRef="Gateway_CheckMerge"/>
    <bpmn:sequenceFlow id="Flow_AddDocuments_CheckMerge" sourceRef="Task_AddDocuments" targetRef="Gateway_CheckMerge"/>
    <bpmn:sequenceFlow id="Flow_CheckMerge_CheckCompleteness" sourceRef="Gateway_CheckMerge" targetRef="Task_CheckCompleteness"/>
    <bpmn:sequenceFlow id="Flow_PayAndSign_IssueInvoice" sourceRef="Task_PayAndSign" targetRef="Task_IssueInvoice"/>
    <bpmn:sequenceFlow id="Flow_IssueInvoice_PayInvoice" sourceRef="Task_IssueInvoice" targetRef="Task_PayInvoice"/>
    <bpmn:sequenceFlow id="Flow_PayInvoice_WorksFork" sourceRef="Task_PayInvoice" targetRef="Gateway_WorksFork"/>
    <bpmn:sequenceFlow id="Flow_Inspection_MeterAdmission" sourceRef="Task_Inspection" targetRef="Task_MeterAdmission"/>
    <bpmn:sequenceFlow id="Flow_MeterAdmission_SignAct" sourceRef="Task_MeterAdmission" targetRef="Task_SignAct"/>
    <bpmn:sequenceFlow id="Flow_SignAct_SendToSupplier" sourceRef="Task_SignAct" targetRef="Task_SendToSupplier"/>
    <bpmn:sequenceFlow id="Flow_SendToSupplier_SupplyContract" sourceRef="Task_SendToSupplier" targetRef="Task_SupplyContract"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_tp861_v3">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_tp861_v3" bpmnElement="Collaboration_tp861_v3">
