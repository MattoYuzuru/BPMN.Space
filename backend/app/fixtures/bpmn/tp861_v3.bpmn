      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_CheckCompleteness_Complete" bpmnElement="Flow_CheckCompleteness_Complete">
        <di:waypoint x="736" y="600"/>
        <di:waypoint x="836" y="600"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Complete_Power" bpmnElement="Flow_Complete_Power">
        <di:waypoint x="886" y="600"/>
