      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_OfferSmall_PowerMerge" bpmnElement="Flow_OfferSmall_PowerMerge">
        <di:waypoint x="1286" y="600"/>
        <di:waypoint x="1386" y="600"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_PowerMerge_PayAndSign" bpmnElement="Flow_PowerMerge_PayAndSign">
        <di:waypoint x="1436" y="600"/>
        <di:waypoint x="1586" y="600"/>
        <di:waypoint x="1586" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_WorksFork_ApplicantWorks" bpmnElement="Flow_WorksFork_ApplicantWorks">
        <di:waypoint x="2186" y="200"/>
        <di:waypoint x="2286" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ApplicantWorks_WorksJoin" bpmnElement="Flow_ApplicantWorks_WorksJoin">
