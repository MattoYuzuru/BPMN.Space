<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TechConnection" targetNamespace="http://arkhitektor.local/bpmn" exporter="arkhitektor" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_TechConnection">
    <bpmn:participant id="Participant_TechConnection" name="Технологическое присоединение (ПП РФ № 861)" processRef="Process_TechConnection" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TechConnection" name="Технологическое присоединение" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TechConnection">
      <bpmn:lane id="Lane_Applicant" name="Заявитель">
        <bpmn:flowNodeRef>Start_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SupplementDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplicantMeasures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyReady</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Grid" name="Сетевая организация">
        <bpmn:flowNodeRef>Task_CheckCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Power</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferSmall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferLarge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PowerJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MeasuresSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GridMeasures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MeasuresJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Connect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignAct</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supplier" name="Гарантирующий поставщик">
        <bpmn:flowNodeRef>Task_SupplyContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Supplied</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Need" name="Нужно присоединить объект">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitApplication" name="Подать заявку через личный кабинет">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_CheckCompleteness" name="Проверить полноту заявки">
      <bpmn:incoming>Flow_Submit_Check</bpmn:incoming>
      <bpmn:incoming>Flow_Supplement_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Complete</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Complete" name="Сведения и документы полные?">
      <bpmn:incoming>Flow_Check_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complete_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyMissing" name="Запросить недостающие сведения">
      <bpmn:incoming>Flow_Complete_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Supplement</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_SupplementDocs" name="Дополнить сведения и документы">
      <bpmn:incoming>Flow_Notify_Supplement</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplement_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Power" name="Максимальная мощность?">
      <bpmn:incoming>Flow_Complete_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Power_Small</bpmn:outgoing>
      <bpmn:outgoing>Flow_Power_Large</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_OfferSmall" name="Разместить договор и ТУ в ЛК (10 р. д.)">
      <bpmn:incoming>Flow_Power_Small</bpmn:incoming>
      <bpmn:outgoing>Flow_Small_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OfferLarge" name="Направить договор и ТУ (20 р. д.)">
      <bpmn:incoming>Flow_Power_Large</bpmn:incoming>
      <bpmn:outgoing>Flow_Large_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PowerJoin">
      <bpmn:incoming>Flow_Small_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Large_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Sign</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SignContract" name="Оплатить счёт и заключить договор">
      <bpmn:incoming>Flow_Join_Sign</bpmn:incoming>
      <bpmn:outgoing>Flow_Sign_Split</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_MeasuresSplit">
      <bpmn:incoming>Flow_Sign_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_Applicant</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_Grid</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_ApplicantMeasures" name="Выполнить ТУ на своём участке">
      <bpmn:incoming>Flow_Split_Applicant</bpmn:incoming>
      <bpmn:outgoing>Flow_Applicant_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GridMeasures" name="Выполнить ТУ до границы участка">
      <bpmn:incoming>Flow_Split_Grid</bpmn:incoming>
      <bpmn:outgoing>Flow_Grid_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_MeasuresJoin">
      <bpmn:incoming>Flow_Applicant_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Grid_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Notify</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Task_NotifyReady" name="Уведомить о выполнении ТУ">
      <bpmn:incoming>Flow_Join_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Inspect</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_Inspect" name="Осмотреть объект и прибор учёта">
      <bpmn:incoming>Flow_Notify_Inspect</bpmn:incoming>
      <bpmn:outgoing>Flow_Inspect_Connect</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Connect" name="Выполнить фактическое подключение">
      <bpmn:incoming>Flow_Inspect_Connect</bpmn:incoming>
      <bpmn:outgoing>Flow_Connect_Act</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SignAct" name="Подписать акт о ТП">
      <bpmn:incoming>Flow_Connect_Act</bpmn:incoming>
      <bpmn:outgoing>Flow_Act_Supply</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SupplyContract" name="Заключить договор поставки">
      <bpmn:incoming>Flow_Act_Supply</bpmn:incoming>
      <bpmn:outgoing>Flow_Supply_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Supplied" name="Поставка энергии начата">
      <bpmn:incoming>Flow_Supply_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="Start_Need" targetRef="Task_SubmitApplication" />
    <bpmn:sequenceFlow id="Flow_Submit_Check" sourceRef="Task_SubmitApplication" targetRef="Task_CheckCompleteness" />
    <bpmn:sequenceFlow id="Flow_Check_Complete" sourceRef="Task_CheckCompleteness" targetRef="Gateway_Complete" />
    <bpmn:sequenceFlow id="Flow_Complete_No" name="Нет" sourceRef="Gateway_Complete" targetRef="Task_NotifyMissing" />
    <bpmn:sequenceFlow id="Flow_Notify_Supplement" sourceRef="Task_NotifyMissing" targetRef="Task_SupplementDocs" />
    <bpmn:sequenceFlow id="Flow_Supplement_Check" sourceRef="Task_SupplementDocs" targetRef="Task_CheckCompleteness" />
    <bpmn:sequenceFlow id="Flow_Complete_Yes" name="Да" sourceRef="Gateway_Complete" targetRef="Gateway_Power" />
    <bpmn:sequenceFlow id="Flow_Power_Small" name="до 150 кВт" sourceRef="Gateway_Power" targetRef="Task_OfferSmall" />
    <bpmn:sequenceFlow id="Flow_Power_Large" name="свыше 150 кВт" sourceRef="Gateway_Power" targetRef="Task_OfferLarge" />
    <bpmn:sequenceFlow id="Flow_Small_Join" sourceRef="Task_OfferSmall" targetRef="Gateway_PowerJoin" />
    <bpmn:sequenceFlow id="Flow_Large_Join" sourceRef="Task_OfferLarge" targetRef="Gateway_PowerJoin" />
    <bpmn:sequenceFlow id="Flow_Join_Sign" sourceRef="Gateway_PowerJoin" targetRef="Task_SignContract" />
    <bpmn:sequenceFlow id="Flow_Sign_Split" sourceRef="Task_SignContract" targetRef="Gateway_MeasuresSplit" />
    <bpmn:sequenceFlow id="Flow_Split_Applicant" sourceRef="Gateway_MeasuresSplit" targetRef="Task_ApplicantMeasures" />
    <bpmn:sequenceFlow id="Flow_Split_Grid" sourceRef="Gateway_MeasuresSplit" targetRef="Task_GridMeasures" />
    <bpmn:sequenceFlow id="Flow_Applicant_Join" sourceRef="Task_ApplicantMeasures" targetRef="Gateway_MeasuresJoin" />
    <bpmn:sequenceFlow id="Flow_Grid_Join" sourceRef="Task_GridMeasures" targetRef="Gateway_MeasuresJoin" />
    <bpmn:sequenceFlow id="Flow_Join_Notify" sourceRef="Gateway_MeasuresJoin" targetRef="Task_NotifyReady" />
    <bpmn:sequenceFlow id="Flow_Notify_Inspect" sourceRef="Task_NotifyReady" targetRef="Task_Inspect" />
    <bpmn:sequenceFlow id="Flow_Inspect_Connect" sourceRef="Task_Inspect" targetRef="Task_Connect" />
    <bpmn:sequenceFlow id="Flow_Connect_Act" sourceRef="Task_Connect" targetRef="Task_SignAct" />
    <bpmn:sequenceFlow id="Flow_Act_Supply" sourceRef="Task_SignAct" targetRef="Task_SupplyContract" />
    <bpmn:sequenceFlow id="Flow_Supply_End" sourceRef="Task_SupplyContract" targetRef="End_Supplied" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_TechConnection">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_TechConnection" bpmnElement="Collaboration_TechConnection">
