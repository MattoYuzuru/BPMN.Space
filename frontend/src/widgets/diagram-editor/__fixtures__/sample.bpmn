      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Connect_Act" bpmnElement="Flow_Connect_Act">
        <di:waypoint x="2586" y="600" />
        <di:waypoint x="2686" y="600" />
      </bpmndi:BPMNEdge>
