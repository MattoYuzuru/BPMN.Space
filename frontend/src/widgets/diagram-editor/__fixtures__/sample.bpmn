        <di:waypoint x="586" y="600" />
        <di:waypoint x="686" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Complete_Yes" bpmnElement="Flow_Complete_Yes">
        <di:waypoint x="736" y="600" />
