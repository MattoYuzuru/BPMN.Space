# За внешним reverse proxy (Caddy/nginx хоста) верим его X-Forwarded-For из частных сетей:
# backend и лимиты частоты видят адрес клиента, а не адрес прокси.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# Общее приложение: статика фронтенда + прокси API.
(app) {
	encode zstd gzip

	# API и SSE: flush_interval -1 отдаёт события прогона сразу, без буферизации.
	handle /api/* {
		reverse_proxy backend:8000 {
			flush_interval -1
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /health {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# MCP-сервер внешних агентов (RFC-0007): Streamable HTTP, вход по Bearer-токену.
	# flush_interval -1 нужен для потоковых ответов MCP; адрес — https://<домен>/mcp.
	handle /mcp {
		reverse_proxy backend:8000 {
			flush_interval -1
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /mcp/* {
		reverse_proxy backend:8000 {
			flush_interval -1
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Инструкция для ИИ-агентов (frontend/public/agents.md) — markdown, а не SPA.
		header /agents.md Content-Type "text/markdown; charset=utf-8"
		try_files {path} /index.html
		file_server
	}
}

# Локальный и IP-стенд остаются доступны по HTTP.
:80 {
	import app
}

# Caddy автоматически получает и обновляет Let's Encrypt сертификаты для домена.
# SITE_ADDRESS задаёт compose.yaml; за внешним прокси с TLS — http://<домен>.
{$SITE_ADDRESS:bpmn.space, www.bpmn.space} {
	import app
}
